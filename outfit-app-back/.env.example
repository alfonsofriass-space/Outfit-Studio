OPENAI_API_KEY=
SESSION_SECRET=replace-with-a-long-random-value-before-sharing
SESSION_COOKIE_SECURE=false
OPENAI_TEXT_MODEL_PRIMARY=gpt-5.4-nano
OPENAI_TEXT_MODEL_FALLBACK=gpt-5.4-mini
OPENAI_PRODUCT_SEARCH_MODEL=gpt-5.4-nano
OPENAI_IMAGE_MODEL=gpt-image-2
IMAGE_QUALITY=low
IMAGE_SIZE=1024x1024
DATABASE_URL=sqlite:///outfit.db
# Timeouts (segundos) de los clientes OpenAI; el default del SDK (600 s) cuelga workers
OPENAI_TIMEOUT_TEXT=60
OPENAI_TIMEOUT_IMAGE=120
